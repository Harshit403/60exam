// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ADMIN ====================
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== STUDENT ====================
model Student {
  id            String   @id @default(cuid())
  fullName      String
  email         String   @unique
  mobile        String   @unique
  password      String
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  status        String   @default("approved") // approved, pending, rejected
  score         Int      @default(0)
  totalStudyMin Int      @default(0)
  currentStreak Int      @default(0)
  lastStrikeAt  DateTime?
  lastStudyAt   DateTime?
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  studySessions  StudySession[]
  studyPlans     StudyPlan[]
  achievements   StudentAchievement[]
  chapterCompletions ChapterCompletion[]
  discussions    Discussion[]
  reviews        Review[]
  quizAttempts   QuizAttempt[]
  notes          Note[]
  groupMemberships GroupMember[]
  groupMessages  GroupMessage[]
  blockedBy      BlockedUser[]
  ipLogs         IpLog[]
  adminNotificationReads AdminNotificationRead[]
  pushSubscriptions     PushSubscription[]
}

// ==================== COURSE ====================
model Course {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students        Student[]
  subjects        Subject[]
  reviews         Review[]
  quizzes         Quiz[]
  studyMaterials  StudyMaterial[]
  adminNotifications AdminNotification[]
}

// ==================== SUBJECT ====================
model Subject {
  id        String   @id @default(cuid())
  name      String
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  orderNum  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapters        Chapter[]
  quizzes         Quiz[]
  studyMaterials  StudyMaterial[]
  studyGroups     StudyGroup[]
}

// ==================== CHAPTER ====================
model Chapter {
  id        String   @id @default(cuid())
  name      String
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completions     ChapterCompletion[]
  studyPlans      StudyPlan[]
  studySessions   StudySession[]
  notes           Note[]
  studyMaterials  StudyMaterial[]
  quizChapterLinks QuizChapterLink[]
}

// ==================== STUDY SESSION ====================
model StudySession {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  chapterId   String?
  chapter     Chapter? @relation(fields: [chapterId], references: [id])
  durationMin Int
  completed   Boolean  @default(false)
  notes       String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
}

// ==================== STUDY PLAN ====================
model StudyPlan {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  chapterId   String?
  chapter     Chapter? @relation(fields: [chapterId], references: [id])
  notes       String?
  plannedDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== CHAPTER COMPLETION ====================
model ChapterCompletion {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id])
  completedAt DateTime @default(now())

  @@unique([studentId, chapterId])
}

// ==================== ACHIEVEMENT ====================
model Achievement {
  id          String   @id @default(cuid())
  name        String
  description String
  threshold   Int      // score needed to unlock
  icon        String?
  order       Int      @default(0)

  studentAchievements StudentAchievement[]
}

model StudentAchievement {
  id            String   @id @default(cuid())
  studentId     String
  student       Student    @relation(fields: [studentId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime   @default(now())

  @@unique([studentId, achievementId])
}

// ==================== REVIEW ====================
model Review {
  id          String   @id @default(cuid())
  authorName  String
  text        String
  rating      Int      @default(5)
  courseId     String?
  course      Course?  @relation(fields: [courseId], references: [id])
  studentId   String?
  student     Student? @relation(fields: [studentId], references: [id])
  source      String   @default("admin") // admin, student
  status      String   @default("approved") // approved, pending, rejected
  createdAt   DateTime @default(now())
}

// ==================== DISCUSSION ====================
model Discussion {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  title       String
  content     String
  parentReplyId String?
  replies     Discussion[] @relation("DiscussionReplies")
  parentReply Discussion?  @relation("DiscussionReplies", fields: [parentReplyId], references: [id])
  adminReply  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== SETTINGS ====================
model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// ==================== QUIZ ====================
model Quiz {
  id          String   @id @default(cuid())
  title       String
  description String?
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id])
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  difficulty  String   @default("medium") // easy, medium, hard
  points      Int      @default(10) // points awarded for passing
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   Question[]
  attempts    QuizAttempt[]
  chapterLinks QuizChapterLink[]
}

model Question {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text        String
  options     String   // JSON-encoded array of options
  correctIdx  Int      // 0-based index of correct option
  explanation String?
  createdAt   DateTime @default(now())
}

model QuizAttempt {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers      String   // JSON-encoded array of selected indices
  score        Int      // number correct
  totalQuestions Int
  passed       Boolean
  pointsEarned Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([studentId, quizId])
}

// ==================== NOTE ====================
model Note {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  chapterId   String?
  chapter     Chapter? @relation(fields: [chapterId], references: [id])
  title       String
  content     String
  color       String   @default("default") // default, yellow, green, blue, pink, purple
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== STUDY MATERIAL ====================
model StudyMaterial {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("pdf") // pdf, video, link, document
  url         String
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id])
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  chapterId   String?
  chapter     Chapter? @relation(fields: [chapterId], references: [id])
  fileSize    String?
  duration    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Update relations: add to Student and other models
// Note: Prisma allows relation fields to be added above; we add reverse relations here
// through Prisma's schema (already declared in their respective models)

// ==================== STUDY GROUP ====================
model StudyGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  maxCapacity Int      @default(10)
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members   GroupMember[]
  messages  GroupMessage[]
}

model GroupMember {
  id         String   @id @default(cuid())
  groupId    String
  group      StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?
  timerState Json?     // { running, paused, remaining, total, chapterName }
}

model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content   String
  type      String    @default("text") // text, image
  createdAt DateTime  @default(now())
}

// ==================== ROOM MESSAGE (Live Chat) ====================
model RoomMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  userName  String
  userRole  String   @default("student") // student, admin
  content   String
  type      String   @default("message") // message, system, admin-reply
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
}

// ==================== BLOCKED USER (from Group Study) ====================
model BlockedUser {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reason    String?
  blockedAt DateTime @default(now())
}

// ==================== IP LOG ====================
model IpLog {
  id        String   @id @default(cuid())
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  ipAddress String
  path      String?
  userAgent String?
  action    String?  // login, visit, signup
  createdAt DateTime @default(now())
}

// ==================== PASSWORD RESET ====================
model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ==================== ADMIN NOTIFICATIONS ====================
model AdminNotification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info") // info, announcement, alert, reminder
  targetRole String  @default("all") // all, student, batch
  targetCourseId String? // null = all courses
  course    Course?  @relation(fields: [targetCourseId], references: [id], onDelete: SetNull)
  createdBy String   // adminId
  createdAt DateTime @default(now())
  // Optional: track reads per student
  reads     AdminNotificationRead[]
}

model AdminNotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  notification   AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  readAt         DateTime @default(now())

  @@unique([notificationId, studentId])
}

// ==================== PUSH SUBSCRIPTION ====================
model PushSubscription {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  endpoint     String   @unique
  p256dh       String
  auth         String
  userAgent    String?
  createdAt    DateTime @default(now())
}

// ==================== QUIZ CHAPTER LINK ====================
model QuizChapterLink {
  id        String   @id @default(cuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([quizId, chapterId])
}
